    @Test
    public void testGetHighestRankedSingle() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        pr.addTeam(a, this.one);
        assertEquals(a, pr.getHighestRanked());
    }
    /**
