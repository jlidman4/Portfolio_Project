    /*Tests for hashCode() */

    /**
     * Test for hashCode(), testing consistency of hashCodes by calling
     * hashCode() on the same object twice and checking if the same output is
     * produced
     */
    @Test
    public void testHashCodeConsistent() {
        PowerRanking pr = this.constructorTest();
        pr.addTeam(new Team("AIK"), this.one);
        int hone = pr.hashCode();
        int htwo = pr.hashCode();
        assertEquals(hone, htwo);
    }

    /**
     * Test for hashCode(), testing if equal objects produce equal hash codes.
     */
    @Test
    public void testHashCodeEqualObjectsEqualHashes() {
        PowerRanking pone = this.constructorTest();
        PowerRanking ptwo = this.constructorTest();
        pone.addTeam(new Team("AIK"), this.one);
        ptwo.addTeam(new Team("AIK"), this.one);
