    @Test
    public void testGetTopNZero() {
        PowerRanking pr = this.constructorTest();
        pr.addTeam(new Team("AIK"), this.one);
        Sequence<Team> top = pr.getTopN(this.zero);
        assertEquals(this.zero, top.length());
    }
     /**
     * Test for getTopN() when called on all teams in PowerRanking object.
     */
    @Test
    public void testGetTopNAll() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        pr.addTeam(a, this.one);
