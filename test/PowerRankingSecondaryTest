    @Test
    public void testSetRankSamePosition() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        pr.setRank(a, this.one);
        assertEquals(a, pr.teamAtRank(this.one));
        assertEquals(b, pr.teamAtRank(this.two));
    }

    /*Tests for setRank() */

    /**
     * Test for setRank(), reshuffling PowerRanking such that the team that is
     * called in "setRank" is moved down.
     */
    @Test
    public void testSetRankMoveDown() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        Team c = new Team("Elfsborg");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        pr.addTeam(c, this.three);
        pr.setRank(a, this.three);
        assertEquals(this.three, pr.size());
        assertEquals(a, pr.teamAtRank(this.three));
    }

    /**
     * Test for setRank(), reshuffling PowerRanking such that the team that is
     * called in "setRank" is moved up.
     */
    @Test
    public void testSetRankMoveUp() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        Team c = new Team("Elfsborg");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        pr.addTeam(c, this.three);
        pr.setRank(c, this.one);
        assertEquals(this.three, pr.size());
        assertEquals(c, pr.teamAtRank(this.one));
    }

    /*Tests for bumpUp()*/

    /**
     * Test for bumpUp(), reshuffling PowerRanking such that the middle team is bumped up.
     */
    @Test
    public void testBumpUpFromMiddle() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        Team c = new Team("Elfsborg");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        pr.addTeam(c, this.three);
        pr.bumpUp(b);
        assertEquals(b, pr.teamAtRank(this.one));
        assertEquals(a, pr.teamAtRank(this.two));
        assertEquals(c, pr.teamAtRank(this.three));
    }

    /**
     * Test for bumpUp() on top ranked team, testing that PowerRanking object's
     * top ranked team is unchanged from before.
     */
    @Test
    public void testBumpUpFromTopUnchanged() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        pr.bumpUp(a);
        assertEquals(a, pr.teamAtRank(this.one));
        assertEquals(b, pr.teamAtRank(this.two));
    }

    /*Tests for bumpDown() */

    /**
