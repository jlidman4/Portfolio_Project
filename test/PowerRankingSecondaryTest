    /*Tests for getRank() */

    /**
     * Test for getRank() with team present.
     */
    @Test
    public void testGetRankPresent() {
        PowerRanking pr = this.constructorTest();
        Team a = new Team("AIK");
        Team b = new Team("Mjallby");
        pr.addTeam(a, this.one);
        pr.addTeam(b, this.two);
        assertEquals(this.one, pr.getRank(a));
        assertEquals(this.two, pr.getRank(b));
    }
    /**
     * Test for getRank() with team not present.
     */
    @Test
    public void testGetRankAbsent() {
        PowerRanking pr = this.constructorTest();
        pr.addTeam(new Team("AIK"), this.one);
        assertEquals(-this.one, pr.getRank(new Team("Hammarby")));
    }

